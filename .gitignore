# Ignore build output and cache
/dist/
/build/
/node_modules/
/.cache/
/.next/
/.vercel/

# Ignore local data and generated files
*.log
*.tmp
*.bak
.DS_Store
.env
.env.local
.env.*.local

# Ignore web assets generated by scripts
/data/*.json
!/data/ecodes.json
!/data/ecodes-qr.json
!/data/merged.json

# Ignore OS and editor files
Thumbs.db
.vscode/
.idea/

# Ignore coverage and test output
coverage/
*.coverage

# Ignore lock files (optional)
package-lock.json
yarn.lock
pnpm-lock.yaml
